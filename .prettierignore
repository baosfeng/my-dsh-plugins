# 依赖与产物目录（与 .gitignore 一致；prettier 默认尊重 .gitignore，此处显式声明保证 CI 行为一致）
node_modules/
coverage/
**/coverage/
.stryker-tmp/
**/.stryker-tmp/
reports/
**/reports/
dist/
build/

# 构建产物：plugins/*/lib/client.js 由 scripts/build.mjs 从 client.src.js 模板 +
# lib/parts/ 片段拼接生成（dsh-mermaid-render 产物内嵌 8.9MB base64，格式化会
# 崩溃/产生巨量 diff），格式化无意义（下次构建即覆盖），与 eslint.config.js
# ignores 保持一致——只格式化 client.src.js 模板与 parts 片段源码。
plugins/*/lib/client.js

# TS 插件（issue #47 / TS 全量迁移）：tsc 编译产物（src/*.ts → lib/*.js +
# lib/*.d.ts）与 client 构建临时目录（lib/.client-build/），格式由编译器决定，
# 下次构建即覆盖——对手写源码做 prettier --check 才有意义。手写的
# lib/parts/*.js 片段与 lib/client.src.js 模板仍照常检查（! 否定规则）。
plugins/*/lib/**/*.js
plugins/*/lib/**/*.d.ts
plugins/*/lib/.client-build/
!plugins/*/lib/parts/**
!plugins/*/lib/client.src.js

# 第三方压缩产物：mermaid 引擎（由 DSH webServer 静态托管给浏览器，见
# test/build-inject.mjs 的 SHA256 冻结断言）。issue #322 起该文件是引擎的**唯一真源**，
# 原先与之逐字节重复的 plugins/dsh-mermaid-render/vendor/mermaid.min.js 已删除。
# issue #296：此前只忽略了 vendor，asset 被 `prettier --write .` 美化后提交
# （6.9MB/177k 行进仓库），随后 `test (dsh-mermaid-render)` 长期红 —— 压缩产物必须
# 始终排除在 prettier 之外，否则下一次有人跑 prettier 就会复现。
plugins/dsh-mermaid-render/assets/mermaid-10.9.3.min.js

# npm 生成的锁文件（格式由 npm 维护，避免与 npm 输出冲突）
package-lock.json

# 本地环境文件（未被 git 跟踪）
.dsh/
.reasonix/
.DS_Store

# CI 自产审查报告（issue #303）：审查 job 在仓库根生成 *-report.md / *-check.txt / *-report.json
# 等中间产物，`prettier --check .` 会扫到它们 → 「格式检查」必然失败（假警报；
# 评论里那条 `[warn] docs-report.md` 就是证据）。这些文件不进版本控制，也不该参与格式门禁。
*-report.md
*-report.txt
*-report.json
*-check.txt

# Markdown 不做格式门禁（README / CHANGELOG / docs）：内容优先于排版，表格对齐、
# 换行风格由作者掌握。文档正确性由 scripts/check-docs.mjs 承担（它用 \s* 容忍空白，
# 不依赖 prettier 对齐）；lint-staged 也不再对 md 跑 prettier --write。
*.md
