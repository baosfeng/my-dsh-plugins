{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "scripts/lib/*.mjs", "scripts/test/*.mjs"],
      "project": ["scripts/**", "*.js", "*.mjs"]
    },
    "plugins/*": {
      "entry": [
        "src/index.ts",
        "src/client/**/*.ts",
        "test/*.mjs",
        "test/features/steps/*.mjs",
        "vitest.stryker.config.mjs"
      ],
      "project": ["src/**", "scripts/**", "test/**", "*.mjs"]
    },
    "plugins/dsh-plugin-dev-mode": {
      "entry": [],
      "project": ["scripts/**", "skills/**"]
    }
  },
  "ignoreDependencies": [
    "dsh-shared",
    "@stryker-mutator/html-reporter",
    "react",
    "dsh-better-sidebar",
    "@deepseek-ai/dsh-client-ui-primitives"
  ],
  "ignoreBinaries": ["dsh"],
  "rules": {
    "types": "warn"
  }
}
