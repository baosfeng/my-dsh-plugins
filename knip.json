{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "scripts/lib/*.mjs", "scripts/test/*.mjs"],
      "project": ["scripts/**", "*.js", "*.mjs"],
      "ignoreDependencies": ["@babel/core", "@babel/preset-typescript"]
    },
    "plugins/*": {
      "entry": ["src/index.ts", "src/client/**/*.ts", "test/*.mjs", "test/features/steps/*.mjs"],
      "project": ["src/**", "scripts/**", "test/**", "*.mjs"]
    }
  },
  "ignoreDependencies": [
    "dsh-shared",
    "react",
    "react-dom",
    "@deepseek-ai/dsh-client-ui-primitives",
    "@types/react-dom",
    "eslint-formatter-compact"
  ],
  "ignoreBinaries": ["dsh", "mkfifo", "pgrep"],
  "rules": {
    "types": "warn"
  }
}
