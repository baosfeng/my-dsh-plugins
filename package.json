{
  "name": "my-dsh-plugins",
  "private": true,
  "type": "module",
  "description": "DSH 插件集合仓库 —— 根工具链（质量门禁：ESLint 复杂度/行数、dependency-cruiser 依赖分析）。各插件测试在 plugins/<name>/ 内独立运行。",
  "scripts": {
    "lint": "eslint plugins/",
    "lint:size": "node scripts/check-ts-size.mjs",
    "depcruise": "depcruise plugins/",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "jscpd": "jscpd",
    "test": "bash scripts/test-all.sh",
    "test:scripts": "node scripts/run-with-timeout.mjs --timeout 300 --label test:scripts -- vitest run --coverage --config scripts/test/vitest.config.mjs",
    "verify": "node scripts/verify-local.mjs",
    "verify:fast": "node scripts/verify-local.mjs --fast",
    "verify:full": "node scripts/verify-local.mjs --full",
    "verify:ci-quality": "node scripts/verify-local.mjs --ci-quality",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "typecheck:plugins": "bash scripts/typecheck-all.sh",
    "check:ts-size": "node scripts/check-ts-size.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:doc-api": "node scripts/check-doc-api-drift.mjs",
    "check:client-modules": "node scripts/check-client-modules.mjs",
    "check:client-size": "node scripts/check-client-size.mjs",
    "check:pack-hygiene": "node scripts/check-pack-hygiene.mjs",
    "check:test-sleeps": "node scripts/check-test-sleeps.mjs",
    "check:gate-parity": "node scripts/check-gate-parity.mjs",
    "check:action-pins": "node scripts/check-action-pins.mjs",
    "lint:commits": "node scripts/check-commit-messages.mjs",
    "secret:scan": "node scripts/check-secrets.mjs",
    "deps:matrix": "node scripts/deps-matrix.mjs",
    "deps:matrix:md": "node scripts/deps-matrix.mjs --markdown",
    "deps:matrix:offline": "node scripts/deps-matrix.mjs --offline",
    "harness:ref": "node scripts/harness-ref.mjs",
    "index:self": "node scripts/index-self.mjs"
  },
  "lint-staged": {
    "*.{js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.ts": [
      "prettier --write"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "dsh-shared": "file:plugins/dsh-shared"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.6",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/lint": "^21.2.2",
    "@commitlint/load": "^21.2.2",
    "@cucumber/cucumber": "^13.2.1",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/html-reporter": "^3.1.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/tmp": "^0.2.6",
    "@vitest/coverage-v8": "^5.0.1",
    "dependency-cruiser": "^18.4.0",
    "eslint": "^10.11.0",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jscpd": "^5.3.1",
    "knip": "^6.37.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "react": "^18.2.0 || ^19.3.0",
    "react-dom": "^18.2.0 || ^19.3.0",
    "tmp": "^0.2.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "qs": "6.16.0",
    "eslint-plugin-import": {
      "eslint": "$eslint"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
