{
  "name": "my-dsh-plugins",
  "private": true,
  "type": "module",
  "description": "DSH 插件集合仓库 —— 根工具链（质量门禁：ESLint 复杂度/行数、dependency-cruiser 依赖分析）。各插件测试在 plugins/<name>/ 内独立运行。",
  "scripts": {
    "lint": "eslint plugins/",
    "lint:size": "node scripts/check-ts-size.mjs",
    "depcruise": "depcruise plugins/",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "jscpd": "jscpd",
    "test": "bash scripts/test-all.sh",
    "test:scripts": "vitest run --coverage --config scripts/test/vitest.config.mjs",
    "verify": "node scripts/verify-local.mjs",
    "verify:fast": "node scripts/verify-local.mjs --fast",
    "verify:full": "node scripts/verify-local.mjs --full",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "typecheck:plugins": "bash scripts/typecheck-all.sh",
    "check:ts-size": "node scripts/check-ts-size.mjs",
    "check:links": "node scripts/check-links.mjs",
    "deps:matrix": "node scripts/deps-matrix.mjs",
    "deps:matrix:md": "node scripts/deps-matrix.mjs --markdown",
    "deps:matrix:offline": "node scripts/deps-matrix.mjs --offline"
  },
  "lint-staged": {
    "*.{js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.ts": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "dsh-better-sidebar": ">=0.14.0",
    "dsh-shared": "file:plugins/dsh-shared"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.4",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@cucumber/cucumber": "^13.2.1",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/html-reporter": "^3.1.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^5.0.0",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.9.0",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jscpd": "^4.3.0",
    "knip": "^6.34.0",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "qs": "6.16.0",
    "eslint-plugin-import": {
      "eslint": "$eslint"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
