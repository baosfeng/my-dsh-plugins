{
  "name": "dsh-my-observability",
  "version": "0.3.4",
  "description": "DSH 可观测性 + Git 工程工具插件：事件审计（agent 行为记录，跨会话持久化 + 查询 API）、资源看门狗面板、结构化 Git 提交（Conventional Commits）、增量 diff 审查（提交前审查）。DSH web plugin: persistent event audit log with query API, resource watchdog panel, structured git commits, pre-commit incremental diff review.",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/baosfeng/my-dsh-plugins"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npx tsc -p tsconfig.json && node scripts/build.mjs",
    "typecheck": "npx tsc --noEmit -p tsconfig.json && npx tsc --noEmit -p tsconfig.client.json",
    "test": "npx vitest run --coverage && cucumber-js test/features --import \"test/features/steps/*.mjs\""
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "assets"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "cordis": "^4.0.0-rc.10",
    "dsh-shared": "^0.1.4",
    "react": "^18.2.0 || ^19.3.0"
  },
  "peerDependenciesMeta": {
    "cordis": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "dependencies": {
    "tmp": "^0.2.7"
  }
}
