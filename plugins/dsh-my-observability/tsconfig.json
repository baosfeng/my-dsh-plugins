{
  // dsh-my-observability — server 端构建配置：src/*.ts → lib/*.js（tsc 编译产物）。
  // 产物必须提交（CI 只跑 node --check + 测试，不跑构建）。
  // src/client 由 tsconfig.client.json 编译（client 端片段，见该文件）。
  "compilerOptions": {
    "strict": true,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "lib",
    "rootDir": "src",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"],
  "exclude": ["src/client"]
}
