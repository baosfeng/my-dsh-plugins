{
  "name": "dsh-my-plugin-manager",
  "version": "0.1.6",
  "description": "DSH 插件市场与更新检查面板：npm 市场关键词搜索、插件详情增强（README / 版本历史 / 依赖 / 月下载量）与更新检查。安装 / 卸载 / 启停 / 清单管理不在范围内——由官方侧边栏插件页与 `dsh plugin` CLI 承担。DSH web plugin: npm market search, richer package detail and update check (install/uninstall/enable/disable and inventory belong to the official plugin manager).",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/baosfeng/my-dsh-plugins"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npx tsc -p tsconfig.json && node scripts/build.mjs",
    "typecheck": "npx tsc --noEmit -p tsconfig.json && npx tsc --noEmit -p tsconfig.client.json",
    "test": "npx vitest run --coverage && cucumber-js test/features --import \"test/features/steps/*.mjs\""
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "assets"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "cordis": "^4.0.0-rc.10",
    "react": "^18.2.0 || ^19.3.0",
    "dsh-shared": "^0.1.4"
  },
  "peerDependenciesMeta": {
    "cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
