{
  "name": "dsh-my-skill-manager",
  "version": "0.2.0",
  "description": "DSH skill 管理：全量 skill 列表 + 全局/项目双作用域启停 + 搜索筛选排序 + 详情与 SKILL.md 预览 + 批量启停 + 扫描诊断。禁用即不注入会话。DSH web plugin: full skill catalog with global/project scoped toggles, search/filter/sort, detail preview, batch actions and scan diagnostics.",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/baosfeng/my-dsh-plugins"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npx tsc -p tsconfig.json && node scripts/build.mjs",
    "typecheck": "npx tsc --noEmit -p tsconfig.json && npx tsc --noEmit -p tsconfig.client.json",
    "test": "npx vitest run --coverage && cucumber-js test/features --import \"test/features/steps/*.mjs\""
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "assets"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "cordis": "^4.0.0-rc.10",
    "react": "^18.2.0 || ^19.2.0"
  },
  "peerDependenciesMeta": {
    "cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "dependencies": {
    "dsh-shared": "^0.1.4"
  }
}
